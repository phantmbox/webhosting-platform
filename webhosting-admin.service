[Unit]
Description=Webhosting Admin Platform
After=network-online.target mysql.service
Wants=network-online.target
[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/webhosting-admin
EnvironmentFile=/etc/webhosting-admin/admin.env
ExecStart=/usr/bin/node /opt/webhosting-admin/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/webhosting/www
[Install]
WantedBy=multi-user.target
